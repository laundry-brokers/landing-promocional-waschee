---
import Layout from "../layouts/Layout.astro";
import NavbarComponente from "../components/NavbarComponente.vue";
import FooterComponent from "../components/FooterComponent.vue";
import FloatingWidgets from "../components/FloatingWidgets.vue";
---

<Layout>
  <!-- Optional Navbar to maintain context -->
  <NavbarComponente client:load />

  <main class="thanks-wrapper d-flex align-items-center justify-content-center">
    <!-- Glowing background accent -->
    <div class="glow-accent"></div>

    <div class="container text-center py-5">
      <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9 col-sm-12">
          <!-- Glassmorphic Card Container -->
          <div class="thanks-card p-5">
            <!-- Animated Check Icon -->
            <div class="icon-pulse-container mb-4">
              <div class="pulse-ring ring-1"></div>
              <div class="pulse-ring ring-2"></div>
              <div class="icon-circle">
                <i class="fa-solid fa-circle-check fa-4x check-icon"></i>
              </div>
            </div>

            <!-- Titles -->
            <h1 class="thanks-title mb-3">
              ¡MUCHAS <span class="highlight-yellow">GRACIAS!</span>
            </h1>
            <h2 class="thanks-subtitle mb-4">HEMOS RECIBIDO TU INFORMACIÓN</h2>

            <!-- Description -->
            <p class="thanks-description mb-5">
              Un asesor especializado de <strong>Waschée</strong> se pondrá en contacto contigo en breve para brindarte cotizaciones personalizadas y todos los detalles de nuestra promoción de <strong>Dúo Industrial</strong>.
            </p>

            <!-- CTA Back to Home -->
            <div class="cta-container">
              <a href="/" class="btn btn-thanks-cta d-inline-flex align-items-center gap-3">
                <i class="fa-solid fa-arrow-left"></i>
                VOLVER AL INICIO
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <FooterComponent client:load />
  <FloatingWidgets client:load />
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

  .thanks-wrapper {
    min-height: 100vh;
    background-color: #000c1a;
    position: relative;
    overflow: hidden;
    padding-top: 100px; /* Offset for navbar */
    font-family: 'Inter', sans-serif;
  }

  /* Radial glowing accent in the background */
  .glow-accent {
    position: absolute;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(229, 169, 60, 0.08) 0%, rgba(0, 12, 26, 0) 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 0;
  }

  /* Premium Card Design with Glassmorphism */
  .thanks-card {
    background: rgba(3, 20, 42, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(16px);
    border-radius: 24px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
    position: relative;
    z-index: 1;
    transition: transform 0.3s ease;
  }

  .thanks-card:hover {
    transform: translateY(-2px);
    border-color: rgba(229, 169, 60, 0.15);
  }

  /* Icon Micro-Animations & Rings */
  .icon-pulse-container {
    position: relative;
    width: 120px;
    height: 120px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-circle {
    width: 100px;
    height: 100px;
    background-color: rgba(229, 169, 60, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #e5a93c;
    z-index: 3;
    box-shadow: 0 0 25px rgba(229, 169, 60, 0.2);
  }

  .check-icon {
    color: #e5a93c;
    animation: scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }

  .pulse-ring {
    position: absolute;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    border: 1px solid rgba(229, 169, 60, 0.4);
    z-index: 2;
  }

  .ring-1 {
    animation: pulseRing 2.5s infinite cubic-bezier(0.215, 0.61, 0.355, 1);
  }

  .ring-2 {
    animation: pulseRing 2.5s infinite cubic-bezier(0.215, 0.61, 0.355, 1);
    animation-delay: 1.25s;
  }

  /* Typography */
  .thanks-title {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 900;
    letter-spacing: -0.01em;
    color: #ffffff;
    line-height: 1.1;
  }

  .highlight-yellow {
    color: #e5a93c;
  }

  .thanks-subtitle {
    font-size: clamp(16px, 1.8vw, 20px);
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.05em;
    opacity: 0.9;
  }

  .thanks-description {
    font-size: clamp(14px, 1.5vw, 16px);
    color: #c9d1d9;
    line-height: 1.6;
    font-weight: 400;
  }

  /* Button Design */
  .btn-thanks-cta {
    background-color: #e5a93c;
    color: #000c1a;
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.05em;
    border-radius: 12px;
    padding: 16px 36px;
    border: none;
    box-shadow: 0 8px 25px rgba(229, 169, 60, 0.25);
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .btn-thanks-cta:hover {
    background-color: #f0b84c;
    color: #000c1a;
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(229, 169, 60, 0.4);
  }

  .btn-thanks-cta:active {
    transform: translateY(-1px);
  }

  /* Animations Keyframes */
  @keyframes scaleIn {
    0% {
      transform: scale(0);
      opacity: 0;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  @keyframes pulseRing {
    0% {
      transform: scale(0.95);
      opacity: 0.8;
    }
    50% {
      opacity: 0.5;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  /* Responsive Adjustments */
  @media (max-width: 767.98px) {
    .thanks-wrapper {
      padding-top: 80px;
    }
    
    .thanks-card {
      padding: 30px 20px !important;
    }
  }
</style>
