---
import "bootstrap/dist/css/bootstrap.min.css";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/logos/favicon_lb.jpg" />
		<link rel="icon" href="/logos/favicon_lb.jpg" />
		<meta name="generator" content={Astro.generator} />
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
			integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg=="
			crossorigin="anonymous"
			referrerpolicy="no-referrer"
		/>
		<title>Laundry Brokers - Todo incluido</title>
	</head>
	<body>
		<slot />

		<!-- Intersection Observer Script for reveal-on-scroll animations -->
		<script is:inline>
			document.addEventListener("DOMContentLoaded", () => {
				const observerOptions = {
					root: null,
					rootMargin: "0px -20px -20px 0px", // slightly offset trigger to feel natural
					threshold: 0.1,
				};

				const observer = new IntersectionObserver((entries, obs) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add("active");
							obs.unobserve(entry.target);
						}
					});
				}, observerOptions);

				const revealElements = document.querySelectorAll(
					".reveal, .reveal-parent",
				);
				revealElements.forEach((el) => observer.observe(el));
			});
		</script>
	</body>
</html>

<style is:global>
	html {
		scroll-behavior: smooth;
		overflow-x: hidden;
	}
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		background-color: #000c1a;
		overflow-x: hidden;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	/* Scroll Reveal Utilities */
	.reveal {
		opacity: 0;
		transform: translateY(25px);
		transition:
			opacity 0.8s cubic-bezier(0.25, 1, 0.5, 1),
			transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
		will-change: opacity, transform;
	}

	.reveal.active {
		opacity: 1;
		transform: translateY(0);
	}

	/* Nested Scroll Reveal for children inside a parent container */
	.reveal-parent .reveal-child {
		opacity: 0;
		transform: translateY(20px);
		transition:
			opacity 0.8s cubic-bezier(0.25, 1, 0.5, 1),
			transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
		will-change: opacity, transform;
	}

	.reveal-parent.active .reveal-child {
		opacity: 1;
		transform: translateY(0);
	}

	/* Delays for staggered child animations */
	.reveal-parent.active .reveal-child:nth-child(1) {
		transition-delay: 100ms;
	}
	.reveal-parent.active .reveal-child:nth-child(2) {
		transition-delay: 200ms;
	}
	.reveal-parent.active .reveal-child:nth-child(3) {
		transition-delay: 300ms;
	}
	.reveal-parent.active .reveal-child:nth-child(4) {
		transition-delay: 400ms;
	}
	.reveal-parent.active .reveal-child:nth-child(5) {
		transition-delay: 500ms;
	}

	/* Immediate load animations for Hero and Navbar (Viewport entry) */
	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.animate-fade-in-up {
		opacity: 0;
		animation: fadeInUp 0.8s cubic-bezier(0.25, 1, 0.5, 1) forwards;
	}

	.animate-delay-1 {
		animation-delay: 150ms;
	}
	.animate-delay-2 {
		animation-delay: 300ms;
	}
</style>
