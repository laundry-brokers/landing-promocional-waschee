		</script>
		<noscript
			><img
				height="1"
				width="1"
				style="display:none"
				src="https://www.facebook.com/tr?id=622081123241956&ev=PageView&noscript=1"
			/></noscript
		>
		<!-- End Meta Pixel Code -->

		<script>
			// Campana: Promo Agosto - Todo incluido Waschee
			(function () {
				const params = new URLSearchParams(window.location.search);
				const persistUtm = (param, storageKey) => {
					const value = params.get(param);
					if (value) {
						sessionStorage.setItem(storageKey, value);
					}
				};
				persistUtm("utm_campaign", "utm_campaign");
				persistUtm("utm_source", "utm_source");
				persistUtm("utm_term", "utm_term");
				persistUtm("utm_medium", "utm_medium");
				persistUtm("utm_content", "utm_content");
				persistUtm("gclid", "gclid");
				persistUtm("fbclid", "fbclid");
			})();

			(function () {
				"use strict";

				const DEFAULT_CAMPAIGN = "Promo Agosto - Todo incluido Waschee";
				const DEFAULT_SOURCE = "Web";
				const API_URL = "https://lglaundrylounge.com/api/track";
				const URL_GRACIAS =
					"https://laundry-brokers.com/todo-incluido/gracias-promocion-waschee/";

				const SUBMITTED_KEY = "kronos_form_submitted";
				const TRACKED_KEY = "kronos_form_tracked";
				const SUBMITTED_AT_KEY = "kronos_form_submitted_at";

				/**
				 * Marca que realmente hubo un envío de formulario.
				 */
				function marcarFormularioEnviado() {
					sessionStorage.setItem(SUBMITTED_KEY, "1");
					sessionStorage.setItem(
						SUBMITTED_AT_KEY,
						Date.now().toString(),
					);

					// Permitimos una nueva conversión para este nuevo envío.
					sessionStorage.removeItem(TRACKED_KEY);
				}

				/**
				 * Detectamos el envío del formulario.
				 */
				document.addEventListener(
					"submit",
					function (event) {
						const form = event.target;

						if (!(form instanceof HTMLFormElement)) {
							return;
						}

						marcarFormularioEnviado();
					},
					true,
				);

				/**
				 * Comprobar si estamos exactamente en la página de gracias.
				 */
				function esPaginaGracias() {
					if (!URL_GRACIAS) {
						return false;
					}

					try {
						const current = new URL(window.location.href);
						const thanks = new URL(URL_GRACIAS);

						return (
							current.origin === thanks.origin &&
							current.pathname.replace(/\/$/, "") ===
								thanks.pathname.replace(/\/$/, "")
						);
					} catch (e) {
						return false;
					}
				}

				/**
				 * Verificar si hubo un formulario enviado recientemente.
				 */
				function huboEnvioValido() {
					const submitted = sessionStorage.getItem(SUBMITTED_KEY);

					const submittedAt = parseInt(
						sessionStorage.getItem(SUBMITTED_AT_KEY) || "0",
						10,
					);

					if (submitted !== "1") {
						return false;
					}

					/**
					 * La redirección deberá ocurrir máximo
					 * 10 minutos después del envío.
					 */
					const MAX_TIME = 10 * 60 * 1000;

					if (!submittedAt || Date.now() - submittedAt > MAX_TIME) {
						limpiarEnvio();

						return false;
					}

					return true;
				}

				function limpiarEnvio() {
					sessionStorage.removeItem(SUBMITTED_KEY);
					sessionStorage.removeItem(SUBMITTED_AT_KEY);
				}

				/**
				 * Registrar conversión.
				 */
				function verificarYEnviar() {
					// 1. No estamos en /gracias.
					if (!esPaginaGracias()) {
						return;
					}

					// 2. Entró directamente a /gracias.
					// NO registrar.
					if (!huboEnvioValido()) {
						console.log(
							"Kronos: acceso directo a página de gracias. No se registra conversión.",
						);

						return;
					}

					// 3. La conversión ya fue registrada.
					if (sessionStorage.getItem(TRACKED_KEY) === "1") {
						console.log("Kronos: conversión ya registrada.");

						return;
					}

					/**
					 * Marcamos ANTES del fetch para impedir
					 * que dos ejecuciones simultáneas disparen
					 * dos conversiones.
					 */
					sessionStorage.setItem(TRACKED_KEY, "1");

					const params = new URLSearchParams(window.location.search);

					const nombreProducto = (
						document.querySelector("h1")?.innerText ||
						document.title
					).substring(0, 250);

					fetch(API_URL, {
						method: "POST",

						headers: {
							"Content-Type": "application/json",
							Accept: "application/json",
							"X-Requested-With": "XMLHttpRequest",
						},

						body: JSON.stringify({
							type: "formulario",

							campaing:
								sessionStorage.getItem("utm_campaign") ||
								params.get("utm_campaign") ||
								DEFAULT_CAMPAIGN,

							fuente:
								sessionStorage.getItem("utm_source") ||
								params.get("utm_source") ||
								DEFAULT_SOURCE,

							producto: nombreProducto,

							url_original:
								document.referrer || window.location.href,

							utm_term:
								sessionStorage.getItem("utm_term") ||
								params.get("utm_term") ||
								null,

							utm_medium:
								sessionStorage.getItem("utm_medium") ||
								params.get("utm_medium") ||
								null,

							utm_content:
								sessionStorage.getItem("utm_content") ||
								params.get("utm_content") ||
								null,

							gclid:
								sessionStorage.getItem("gclid") ||
								params.get("gclid") ||
								null,

							fbclid:
								sessionStorage.getItem("fbclid") ||
								params.get("fbclid") ||
								null,

							referer: document.referrer || null,
						}),
					})
						.then(async (response) => {
							if (!response.ok) {
								throw new Error("HTTP " + response.status);
							}

							return response.json();
						})
						.then((data) => {
							console.log(
								"Kronos: formulario registrado correctamente.",
								data,
							);

							/**
							 * Eliminamos la bandera del envío.
							 * Dejamos TRACKED_KEY para impedir
							 * recargas duplicadas.
							 */
							limpiarEnvio();
						})
						.catch((error) => {
							console.error(
								"Kronos: error registrando formulario.",
								error,
							);

							/**
							 * Si falló realmente la API,
							 * permitimos reintentar.
							 */
							sessionStorage.removeItem(TRACKED_KEY);
						});
				}

				/**
				 * Primera carga.
				 */
				if (
					document.readyState === "complete" ||
					document.readyState === "interactive"
				) {
					verificarYEnviar();
				} else {
					document.addEventListener(
						"DOMContentLoaded",
						verificarYEnviar,
					);
				}

				/**
				 * Soporte SPA / Framer.
				 */
				let lastUrl = window.location.href;

				const observer = new MutationObserver(function () {
					const currentUrl = window.location.href;

					if (currentUrl !== lastUrl) {
						lastUrl = currentUrl;

						verificarYEnviar();
					}
				});

				if (document.body) {
					observer.observe(document.body, {
						childList: true,
						subtree: true,
					});
				}
			})();
		</script>
		<!-- Google Tag Manager -->
		<script>
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({
					"gtm.start": new Date().getTime(),
					event: "gtm.js",
				});
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != "dataLayer" ? "&l=" + l : "";
				j.async = true;
				j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, "script", "dataLayer", "GTM-KHD3JM6");
		</script>
		<!-- End Google Tag Manager -->
	</head>
	<body>
		<slot />

		<!-- Intersection Observer Script for reveal-on-scroll animations -->
		<script is:inline>
			document.addEventListener("DOMContentLoaded", () => {
				const observerOptions = {
					root: null,
					rootMargin: "0px -20px -20px 0px", // slightly offset trigger to feel natural
					threshold: 0.1,
				};

				const observer = new IntersectionObserver((entries, obs) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add("active");
							obs.unobserve(entry.target);
						}
					});
				}, observerOptions);

				const revealElements = document.querySelectorAll(
					".reveal, .reveal-parent",
				);
				revealElements.forEach((el) => observer.observe(el));
			});
		</script>

		<script>
			// Campana: Promo Agosto - Todo incluido
			(function () {
				const params = new URLSearchParams(window.location.search);
				const persistUtm = (param, storageKey) => {
					const value = params.get(param);
					if (value) {
						sessionStorage.setItem(storageKey, value);
					}
				};
				persistUtm("utm_campaign", "utm_campaign");
				persistUtm("utm_source", "utm_source");
				persistUtm("utm_term", "utm_term");
				persistUtm("utm_medium", "utm_medium");
				persistUtm("utm_content", "utm_content");
				persistUtm("gclid", "gclid");
				persistUtm("fbclid", "fbclid");
			})();
			(function () {
				"use strict";

				const DEFAULT_CAMPAIGN = "Promo Agosto - Todo incluido";
				const DEFAULT_SOURCE = "Web";
				const CAMPAIGN_URL =
					"https://laundry-brokers.com/todo-incluido/";
				const urlApi = "https://lglaundrylounge.com/api/track";

				function trackWhatsApp() {
					const currentUrl = window.location.href;
					if (CAMPAIGN_URL && !currentUrl.startsWith(CAMPAIGN_URL))
						return;
					if (window.__kronosWhatsappTracked) return;

					window.__kronosWhatsappTracked = true;
					const params = new URLSearchParams(window.location.search);
					const nombreProducto =
						document.querySelector("h1")?.innerText ||
						document.title;

					fetch(urlApi, {
						method: "POST",
						headers: {
							"Content-Type": "application/json",
							Accept: "application/json",
							"X-Requested-With": "XMLHttpRequest",
						},
						body: JSON.stringify({
							type: "whatsapp",
							campaing:
								sessionStorage.getItem("utm_campaign") ||
								params.get("utm_campaign") ||
								DEFAULT_CAMPAIGN,
							fuente:
								sessionStorage.getItem("utm_source") ||
								params.get("utm_source") ||
								DEFAULT_SOURCE,
							producto: nombreProducto.substring(0, 250),
							url_original: currentUrl,
							utm_term:
								sessionStorage.getItem("utm_term") ||
								params.get("utm_term") ||
								null,
							utm_medium:
								sessionStorage.getItem("utm_medium") ||
								params.get("utm_medium") ||
								null,
							utm_content:
								sessionStorage.getItem("utm_content") ||
								params.get("utm_content") ||
								null,
							gclid:
								sessionStorage.getItem("gclid") ||
								params.get("gclid") ||
								null,
							fbclid:
								sessionStorage.getItem("fbclid") ||
								params.get("fbclid") ||
								null,
							referer: document.referrer || null,
						}),
					})
						.then((res) => res.json())
						.then((data) =>
							console.log("WhatsApp Registrado:", data),
						)
						.catch((err) => console.error("Error:", err));
				}

				// Compatibilidad WP (JoinChat)
				document.addEventListener("joinchat:open", trackWhatsApp);

				// Compatibilidad HTML Universal / Framer: Escuchar clicks globales en enlaces de WhatsApp
				document.addEventListener("click", function (e) {
					const target = e.target.closest("a");
					if (!target) return;

					const href = target.getAttribute("href") || "";
					// Detecta patrones comunes de API o links directos de WhatsApp
					if (
						href.includes("wa.me") ||
						href.includes("api.whatsapp.com") ||
						href.includes("whatsapp://")
					) {
						trackWhatsApp();
					}
				});
			})();
		</script>
		<!-- Google Tag Manager (noscript) -->
		<noscript
			><iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-KHD3JM6"
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe></noscript
		>
		<!-- End Google Tag Manager (noscript) -->
	</body>
</html>

<style is:global>
	html {
		scroll-behavior: smooth;
		overflow-x: hidden;
	}
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		background-color: #000c1a;
		overflow-x: hidden;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	/* Scroll Reveal Utilities */
	.reveal {
		opacity: 0;
		transform: translateY(25px);
		transition:
			opacity 0.8s cubic-bezier(0.25, 1, 0.5, 1),
			transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
		will-change: opacity, transform;
	}

	.reveal.active {
		opacity: 1;
		transform: translateY(0);
	}

	/* Nested Scroll Reveal for children inside a parent container */
	.reveal-parent .reveal-child {
		opacity: 0;
		transform: translateY(20px);
		transition:
			opacity 0.8s cubic-bezier(0.25, 1, 0.5, 1),
			transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
		will-change: opacity, transform;
	}

	.reveal-parent.active .reveal-child {
		opacity: 1;
		transform: translateY(0);
	}

	/* Delays for staggered child animations */
	.reveal-parent.active .reveal-child:nth-child(1) {
		transition-delay: 100ms;
	}
	.reveal-parent.active .reveal-child:nth-child(2) {
		transition-delay: 200ms;
	}
	.reveal-parent.active .reveal-child:nth-child(3) {
		transition-delay: 300ms;
	}
	.reveal-parent.active .reveal-child:nth-child(4) {
		transition-delay: 400ms;
	}
	.reveal-parent.active .reveal-child:nth-child(5) {
		transition-delay: 500ms;
	}

	/* Immediate load animations for Hero and Navbar (Viewport entry) */
	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.animate-fade-in-up {
		opacity: 0;
		animation: fadeInUp 0.8s cubic-bezier(0.25, 1, 0.5, 1) forwards;
	}

	.animate-delay-1 {
		animation-delay: 150ms;
	}
	.animate-delay-2 {
		animation-delay: 300ms;
	}

